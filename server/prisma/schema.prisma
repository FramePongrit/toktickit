// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums -----------------------------------------------------------------

// Declared in severity order: PostgreSQL sorts enum values by declaration
// order, so `sort=requestedPriority` is only meaningful with this ordering.
enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  REOPENED
  CLOSED
  CANCELLED
}

enum ActionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActionRevisionOperation {
  CREATE
  EDIT
  TRANSITION
  TICKET_CANCEL
}

enum TicketWorkflowEventKind {
  CREATED
  BASELINE
  TRANSITION
}

enum Role {
  REQUESTER
  STAFF
  ADMIN
}

// --- Reference data --------------------------------------------------------

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

// --- Identity --------------------------------------------------------------

// Lab 3 evolves the Lab 2 RequesterUser table in place. The migration renames
// the table and keeps its primary keys so Ticket and Attachment ownership
// remains historical data, not a copied relationship.
model User {
  id                 Int      @id @default(autoincrement())
  fullName           String
  email              String   @unique
  active             Boolean  @default(true)
  role               Role     @default(REQUESTER)
  passwordHash       String?
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tickets               Ticket[]        @relation("TicketRequester")
  ownedTickets          Ticket[]        @relation("TicketOwner")
  resolutionIndications Ticket[]        @relation("ResolutionIndication")
  sessions              AuthSession[]
  publicComments        PublicComment[]
  internalNotes         InternalNote[]
  uploadedAttachments   Attachment[]    @relation("AttachmentUploader")
  removedAttachments    Attachment[]    @relation("AttachmentRemover")
  assignedActions       ActionTaken[]   @relation("ActionAssignee")
  createdActions        ActionTaken[]   @relation("ActionCreator")
  performedActions      ActionTaken[]   @relation("ActionPerformer")
  cancelledActions      ActionTaken[]   @relation("ActionCanceller")
  actionRevisions       ActionRevision[]
  workflowEvents        TicketWorkflowEvent[]
  idempotencyRecords    IdempotencyRecord[]

  @@index([active, role])
  @@index([role, active, fullName])
}

model AuthSession {
  id                  String    @id @default(cuid())
  userId              Int
  csrfTokenHash       String    @unique
  csrfTokenCiphertext String?
  issuedAt            DateTime  @default(now())
  expiresAt           DateTime
  revokedAt           DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([revokedAt, expiresAt])
}

// --- Tickets ---------------------------------------------------------------

model Ticket {
  id                      Int          @id @default(autoincrement())
  ticketNumber            String       @unique
  requesterId             Int
  categoryId              Int
  relatedSystemId         Int
  requestedPriority       Priority
  itPriority              Priority
  ownerId                 Int?
  summary                 String       @db.VarChar(200)
  description             String       @db.Text
  currentStatus           TicketStatus @default(NEW)
  workCycle               Int          @default(1)
  version                 Int          @default(1)
  resolvedAt              DateTime?
  resolutionIndicatedAt   DateTime?
  resolutionIndicatedById Int?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  // Restrict, not Cascade: reference data and historical identities must not
  // be deletable while tickets or attachments point at them.
  requester             User            @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  owner                 User?           @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  resolutionIndicatedBy User?           @relation("ResolutionIndication", fields: [resolutionIndicatedById], references: [id], onDelete: Restrict)
  category              Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  relatedSystem         RelatedSystem   @relation(fields: [relatedSystemId], references: [id], onDelete: Restrict)
  attachments           Attachment[]
  publicComments        PublicComment[]
  internalNotes         InternalNote[]
  actions               ActionTaken[]
  workflowEvents        TicketWorkflowEvent[]

  @@index([requesterId, createdAt])
  @@index([requesterId, updatedAt, id])
  @@index([requesterId, currentStatus, resolvedAt, id])
  @@index([requesterId, categoryId])
  @@index([requesterId, relatedSystemId])
  @@index([ownerId, currentStatus])
  @@index([currentStatus, itPriority, createdAt, id])
  @@index([currentStatus, itPriority, updatedAt, id])
  @@index([resolutionIndicatedById])
}

model ActionTaken {
  id                 Int         @id @default(autoincrement())
  ticketId           Int
  workCycle          Int
  status             ActionStatus @default(PLANNED)
  description        String      @db.Text
  result             String?     @db.Text
  actionAt           DateTime
  assigneeId         Int
  createdById        Int
  performedById      Int?
  followUpRequired   Boolean     @default(false)
  followUpNote       String?     @db.Text
  attachmentNotes    String?     @db.Text
  version            Int         @default(1)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelledById      Int?
  cancelReason       String?     @db.Text

  ticket      Ticket  @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  assignee    User    @relation("ActionAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy   User    @relation("ActionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  performedBy User?   @relation("ActionPerformer", fields: [performedById], references: [id], onDelete: Restrict)
  cancelledBy User?   @relation("ActionCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  revisions   ActionRevision[]

  @@index([ticketId, createdAt, id])
  @@index([ticketId, workCycle, status])
  @@index([assigneeId, status, ticketId])
  @@index([performedById, completedAt, id])
}

model ActionRevision {
  id         Int                     @id @default(autoincrement())
  actionId   Int
  sequence   Int
  operation  ActionRevisionOperation
  actorId    Int
  occurredAt DateTime                @default(now())
  reason     String?                 @db.Text
  before     Json?
  after      Json

  action ActionTaken @relation(fields: [actionId], references: [id], onDelete: Restrict)
  actor  User        @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actionId, sequence])
}

model TicketWorkflowEvent {
  id              Int                     @id @default(autoincrement())
  ticketId        Int
  workCycle       Int
  kind            TicketWorkflowEventKind
  fromStatus      TicketStatus?
  toStatus        TicketStatus
  actorId         Int?
  occurredAt      DateTime                @default(now())
  publicCommentId Int?
  reason          String?                 @db.Text
  ticketVersion   Int                     @default(1)

  ticket        Ticket         @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  actor         User?          @relation(fields: [actorId], references: [id], onDelete: Restrict)
  publicComment PublicComment? @relation(fields: [publicCommentId], references: [id], onDelete: SetNull)

  @@index([ticketId, occurredAt, id])
}

model IdempotencyRecord {
  id             Int      @id @default(autoincrement())
  userId         Int
  method         String   @db.VarChar(6)
  canonicalPath  String   @db.VarChar(500)
  key            String   @db.Uuid
  payloadDigest  String   @db.Char(64)
  httpStatus     Int
  response       Json
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, method, canonicalPath, key])
}

// An Attachment is active if and only if `removedAt` is null. That single
// nullable timestamp is the only source of truth — there is deliberately no
// companion boolean, because two representations of one fact can disagree.
model Attachment {
  id                    Int       @id @default(autoincrement())
  ticketId              Int
  originalFilename      String
  storedFilename        String    @unique
  mimeType              String
  sizeBytes             Int
  uploadedByRequesterId Int
  uploadedAt            DateTime  @default(now())
  removedAt             DateTime?
  removedByRequesterId  Int?
  removalReason         String?

  ticket     Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation("AttachmentUploader", fields: [uploadedByRequesterId], references: [id], onDelete: Restrict)
  removedBy  User?  @relation("AttachmentRemover", fields: [removedByRequesterId], references: [id], onDelete: Restrict)

  @@index([ticketId, removedAt])
}

model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  body      String   @db.Text
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)
  workflowEvents TicketWorkflowEvent[]

  @@index([ticketId, createdAt, id])
  @@index([authorId, createdAt])
}

model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  body      String   @db.Text
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt, id])
  @@index([authorId, createdAt])
}

// --- Ticket number allocation ----------------------------------------------

// One row per calendar year. Allocation runs inside the ticket-creation
// transaction as `UPDATE ... SET lastValue = lastValue + 1 ... RETURNING`,
// which row-locks the year so concurrent creates serialise on it.
model TicketCounter {
  year      Int @id
  lastValue Int @default(0)
}
